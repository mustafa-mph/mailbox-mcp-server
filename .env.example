# Copy to .env and fill in.  Never commit .env.

# ---------- Required ----------
# Public HTTPS URL clients connect to (your reverse proxy points this at port 3900)
PUBLIC_BASE_URL=https://mcp.example.com

# Encrypts saved user sign-ins. Generate with:  openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# ---------- Per-user sign-in (recommended) ----------
# Each user connects and signs in with their own mailbox email + password.
# The password is checked by logging in to this IMAP server.
USER_IMAP_HOST=mail.example.com
USER_IMAP_PORT=993
USER_IMAP_SECURE=true
USER_SMTP_HOST=mail.example.com
USER_SMTP_PORT=465
USER_SMTP_SECURE=true
# Only allow addresses @this domain to sign in. Leave empty to allow any mailbox on the server.
USER_MAIL_DOMAIN=example.com
# Name shown on the sign-in page
BRAND_NAME=Example Mail

# ---------- Mailcow admin API (optional) ----------
# Adds server management tools (domains, mailboxes, aliases, queue, sync jobs, logs, DKIM, quarantine)
# and self-service tools for every signed-in user (own quota, aliases, app passwords, quarantine).
# Create the key in Mailcow: System > Configuration > Access > API (allow this server's IP).
MAILCOW_API_URL=
MAILCOW_API_KEY=
# read-write (default) or read-only. read-only hides every tool that changes something.
MAILCOW_API_ACCESS=read-write
# Signed-in users who also get the admin tools (owner-token callers always do)
ADMIN_EMAILS=
# MAILCOW_API_TIMEOUT_MS=20000

# ---------- Owner accounts (optional) ----------
# Fixed accounts reachable with a static bearer token instead of the sign-in page.
# OWNER_ACCOUNTS=work,personal  then define WORK_* and PERSONAL_* below.
OWNER_ACCOUNTS=
# Required when OWNER_ACCOUNTS is set. Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# WORK_IMAP_HOST=mail.example.com
# WORK_IMAP_PORT=993
# WORK_IMAP_SECURE=true
# WORK_SMTP_HOST=mail.example.com
# WORK_SMTP_PORT=465
# WORK_SMTP_SECURE=true
# WORK_EMAIL_ADDRESS=me@example.com
# WORK_EMAIL_PASSWORD=

# Gmail needs an App Password (Google Account > Security > App passwords), not your normal password.
# PERSONAL_IMAP_HOST=imap.gmail.com
# PERSONAL_IMAP_PORT=993
# PERSONAL_SMTP_HOST=smtp.gmail.com
# PERSONAL_SMTP_PORT=465
# PERSONAL_EMAIL_ADDRESS=me@gmail.com
# PERSONAL_EMAIL_PASSWORD=

# ---------- Advanced ----------
# PORT=3900
# SESSION_FILE=/data/sessions.json
# Number of reverse proxies in front of the server (used to find the real client IP for rate limiting)
# TRUST_PROXY_HOPS=1
